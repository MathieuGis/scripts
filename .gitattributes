# Canonical text in Git; Windows scripts check out with CRLF, Bash with LF.
* text=auto
*.ps1 text eol=crlf
*.bat text eol=crlf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.rar binary
# Preserve historical material and the frozen snapshot byte for byte.
/archive/** -text
/backup/** -text
